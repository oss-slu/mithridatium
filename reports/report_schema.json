{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"required": [
		"mithridatium_version",
		"timestamp_utc",
		"model_path",
		"dataset",
		"results"
	],
	"anyOf": [
		{
			"required": ["defense"],
			"not": {
				"required": ["method"]
			}
		}, 
		{
			"required": ["method"], 
			"not": {
				"required": ["defense"]
			}
		}
	],
	"properties": {
		"mithridatium_version": {
			"type": "string"
		},
		"timestamp_utc": {
			"type": "string"
		},
		"model_path": {
			"type": "string"
		},
		"defense": {
			"type": "string"
		},
		"method": {
			"type": "string"
		},
		"dataset": {
			"type": "string"
		},
		"results": {
			"type": "object"
		}
	},
	"allOf": [
		{
			"if": {
				"properties": {
					"defense": {
						"const": "freeeagle"
					}
				},
				"required": [
					"defense"
				]
			},
			"then": {
				"properties": {
					"results": {
						"type": "object",
						"required": [
							"defense",
							"anomaly_metric",
							"anomaly_matrix",
							"tendency_per_target",
							"verdict",
							"thresholds",
							"parameters",
							"dataset"
						],
						"properties": {
							"defense": {
								"type": "string",
								"const": "freeeagle"
							},
							"anomaly_metric": {
								"type": "number"
							},
							"anomaly_matrix": {
								"type": "array",
								"items": {
									"type": "array",
									"items": {
										"type": "number"
									}
								}
							},
							"tendency_per_target": {
								"type": "array",
								"items": {
									"type": "number"
								}
							},
							"verdict": {
								"type": "string"
							},
							"thresholds": {
								"type": "object",
								"required": [
									"anomaly_metric_threshold"
								],
								"properties": {
									"anomaly_metric_threshold": {
										"type": "number"
									}
								},
								"additionalProperties": true
							},
							"parameters": {
								"type": "object",
								"required": [
									"num_classes",
									"inspect_layer_position",
									"optimize_steps",
									"input_shape"
								],
								"properties": {
									"num_classes": {
										"type": "integer"
									},
									"inspect_layer_position": {
										"type": "integer"
									},
									"optimize_steps": {
										"type": "integer"
									},
									"input_shape": {
										"type": "array",
										"items": {
											"type": "integer"
										}
									}
								},
								"additionalProperties": true
							},
							"dataset": {
								"type": "string"
							}
						},
						"additionalProperties": true
					}
				},
				"required": [
					"results"
				]
			}
		},
		{
			"if": {
				"required": [
					"method"
				]
			},
			"then": {
				"properties": {
					"method": {
						"type": "string",
						"minLength": 1
					},
					"results": {
						"type": "object",
						"required": [
							"verdict",
							"parameters"
						],
						"properties": {
							"verdict": {
								"type": "string"
							},
							"parameters": {
								"type": "object"
							}
						},
						"additionalProperties": true
					}
				},
				"required": [
					"method",
					"results"
				]
			}
		},
		{
			"if": {
				"properties": {
					"defense": { "const": "scaleup" }
				},
				"required": ["defense"]
			},
			"then": {
				"properties": {
					"results": {
						"required": [
							"mode",
							"method",
							"verdict",
							"num_inputs",
							"num_flagged",
							"threshold",
							"parameters",
							"per_sample"
						],
						"properties": {
							"mode": { "const": "input-level" },
							"method": { "const": "scaleup" },
							"per_sample": {
								"type": "array",
								"items": {
									"required": ["index", "predicted_label", "score", "flagged"]
								}
							}
						}
					}
				}
			}
		},

		{
			"if": {
				"properties": { "method": { "const": "anp" } },
				"required": ["method"]
			},
			"then": {
				"properties": {
					"results": {
						"required": [
							"method", "status", "total_channels_pruned",
							"clean_accuracy_before", "clean_accuracy_after"
						],
						"properties": {
							"method": { "const": "anp" },
							"status": { "type": "string" },
							"total_channels_pruned": { "type": "integer", "minimum": 0 },
							"layer_breakdown": {
								"type": "array",
								"items": {
									"type": "object",
									"required": ["layer", "channels_pruned"],
									"properties": {
										"layer": { "type": "string" },
										"channels_pruned": { "type": "integer", "minimum": 1 },
										"indices": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
									}
								}
							},
							"clean_accuracy_before": { "type": "number", "minimum": 0, "maximum": 1 },
							"clean_accuracy_after": { "type": "number", "minimum": 0, "maximum": 1 },
							"asr_before": { "type": "number", "minimum": 0, "maximum": 1 },
							"asr_after": { "type": "number", "minimum": 0, "maximum": 1 },
							"asr_evaluation_samples": { "type": "integer", "minimum": 1 }
						},
						"dependencies": {
							"asr_before": ["asr_after", "asr_evaluation_samples"],
							"asr_after": ["asr_before", "asr_evaluation_samples"],
							"asr_evaluation_samples": ["asr_before", "asr_after"]
						}
					}
				}
			}
		},
    		{
			"if": {
				"properties": {
					"defense": { "const": "clp" }
				},
				"required": ["defense"]
			},
			"then": {
				"properties": {
					"results": {
						"type": "object",
						"required": ["method", "parameters", "total_channels_pruned", "status"],
						"properties": {
							"method": { "type": "string", "const": "clp" },
							"parameters": {
								"type": "object",
								"required": ["threshold_mult"],
								"properties": {
									"threshold_mult": { "type": "number", "minimum": 0 }
								}
							},
							"total_channels_pruned": { "type": "integer", "minimum": 0 },
							"layer_breakdown": {
								"type": "array",
								"items": {
									"type": "object",
									"required": ["layer", "channels_pruned"],
									"properties": {
										"layer": { "type": "string" },
										"channels_pruned": { "type": "integer", "minimum": 1 }
									}
								}
							},
							"status": { "type": "string" }
						},
						"additionalProperties": true
					}
				},
				"required": ["results"]
			}
		}
	]
}
